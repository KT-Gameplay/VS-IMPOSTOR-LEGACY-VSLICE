function showDoubleTroubleOverlay():Void
{
	if (dtCam == null)
	{
		dtCam = new FlxCamera();
		dtCam.bgColor = 0xFF000000;
		FlxG.cameras.add(dtCam, false);
	}

	FlxG.sound.play(Paths.sound('confirmMenu'), 0.8);

	var dtIcon:FlxSprite = new FlxSprite();
	dtIcon.loadGraphic(Paths.image('icons/icon-double-trouble'));
	var iconFrameWidth:Int = Std.int(dtIcon.width * 0.5);
	dtIcon.loadGraphic(Paths.image('icons/icon-double-trouble'), true, iconFrameWidth, Std.int(dtIcon.height));
	dtIcon.animation.add('idle', [0], 0, false);
	dtIcon.animation.play('idle');
	dtIcon.camera = dtCam;
	dtIcon.scrollFactor.set();
	dtIcon.alpha = 0;
	add(dtIcon);

	var line0:FlxText = new FlxText(0, 0, FlxG.width, 'You can now play Double Trouble.', 42);
	line0.setFormat(Paths.font('vcr.ttf'), 42, 0xFFFFFFFF, 'center');
	line0.borderStyle = FlxTextBorderStyle.OUTLINE;
	line0.borderColor = 0xFF000000;
	line0.borderSize = 2;
	line0.camera = dtCam;
	line0.screenCenter();
	line0.y -= 20;
	line0.alpha = 0;
	add(line0);

	dtIcon.screenCenter();
	dtIcon.y = line0.y - dtIcon.height - 26;

	var line1:FlxText = new FlxText(0, 0, FlxG.width, '(In the Freeplay menu! Under bonus songs!)', 28);
	line1.setFormat(Paths.font('vcr.ttf'), 28, 0xFFFFFFFF, 'center');
	line1.borderStyle = FlxTextBorderStyle.OUTLINE;
	line1.borderColor = 0xFF000000;
	line1.borderSize = 2;
	line1.camera = dtCam;
	line1.screenCenter();
	line1.y = line0.y + line0.height + 10;
	line1.alpha = 0;
	add(line1);

	FlxTween.tween(dtIcon, {alpha: 1}, 0.8, {ease: FlxEase.quadOut});
	FlxTween.tween(line0, {alpha: 1}, 0.8, {ease: FlxEase.quadOut});
	new FlxTimer().start(3, function(_) {
		FlxTween.tween(line1, {alpha: 1}, 0.8, {ease: FlxEase.quadOut});

		new FlxTimer().start(10, function(_) {
			FlxTween.tween(dtIcon, {alpha: 0}, 0.45, {ease: FlxEase.quadIn});
			FlxTween.tween(line0, {alpha: 0}, 0.35, {ease: FlxEase.quadIn});
			FlxTween.tween(line1, {alpha: 0}, 0.35,
				{
					ease: FlxEase.quadIn,
					onComplete: function(_) {
						if (onFinish != null) onFinish();
						close();
					}
				});
		});
	});
}

var onSkip:Void->Void = null;
var onFinish:Void->Void = null;
var camCredits:FlxCamera;
var canSkip:Bool = true;

var manager;

function create():Void
{
	super.create();

	this.bgColor = 0xFF000000;

	var insertPos:Int = credits.length - 3;
		var porterEntries:Array<Dynamic> = [
			{name: 'V-Slice Team'},
			{icon: 'none', name: 'KT_Gameplay'},
			{icon: 'none', name: 'Zanguy'},
			{icon: 'none', name: 'jarekboho'},
			{icon: 'none', name: 'Juxz'},
			{icon: 'none', name: 'Thialesssu'},
			{icon: 'none', name: 'Brenninho'},
		];
		
		for (i in 0...porterEntries.length)
			credits.insert(insertPos + i, porterEntries[i]);

	FlxG.cameras.add(camera = camCredits = new FlxCamera(), false);
	camCredits.bgColor = 0;

	creditsGroup = new FlxSpriteGroup(60, FlxG.height);
	loadCredits();
	add(creditsGroup);

	blackAtlas = new FunkinSprite().loadTextureAtlas('credits/roll/black');
	blackAtlas.kill();
	add(blackAtlas);

	persistentUpdate = true;

	manager = new StringMap();
	manager.set('rollSize', 0);
	manager.set('rollAlpha', 0);
	manager.set('titleAlpha', 0);

	title = add(new FlxText(0, 0, 640, 'test'));
	title.setFormat(Paths.font('impact.ttf'), 56, 0xFFFFFFFF, 'center');
	title.scrollFactor.set();

	title.x = (FlxG.width - title.width - 48);

	portrait = add(new FunkinSprite(0, 0, rollImage('introA')));
	portrait.useRenderTexture = true;
	portrait.scrollFactor.set();
	portrait.screenCenter();

	portraitBorder = add(new FunkinSprite(0, 0, Paths.image('credits/rollBorder')));
	portraitBorder.scale.set(1280 / 1920, 1280 / 1920);
	portraitBorder.updateHitbox();
	portraitBorder.scrollFactor.set();
	portraitBorder.screenCenter();
	portraitBorder.setPosition(576, portraitBorder.y - 4);
	portraitBorder.kill();

	thx = add(new FlxText(0, 0, FlxG.width, ' \n \n '));
	thx.setFormat(Paths.font('impact.ttf'), 180, 0xFFFFFFFF, 'center');
	thx.scrollFactor.set();
	thx.screenCenter();
	thx.active = false;

	songCreditGroup = add(new FlxSpriteGroup());
	songCreditGroup.scrollFactor.set();
	songCreditGroup.alpha = 0;
	songCreditGroup.y = FlxG.height - 65;
	songCreditGroup.x = FlxG.width + 40;

	disc = new FlxSprite(0, 0, Paths.image('credits/disc'));
	disc.setGraphicSize(50, 50);
	disc.updateHitbox();
	disc.color = 0xFF292929;
	disc.angularVelocity = 250;

	songCredit = new FlxText(disc.width + 10, 0, 0, '"Sussus Endus" - punkett, emihead');
	songCredit.setFormat(Paths.font('impact.ttf'), 34, 0xFF292929, 'left');
	songCredit.active = false;
	disc.y = (songCredit.height - disc.height) / 2;

	songCreditGroup.add(disc);
	songCreditGroup.add(songCredit);

	manager.set('rollSize', 640);
	queueEase(0, 28 * 4, 'rollSize', 1080);
	queueRollImage(0, 'introA');
	queueRollImage(8, 'introB');
	queueRollImage(16, 'introC');
	queueRollImage(24, 'introD');

	centerRoll = true;
	portrait.screenCenter();

	queueFuncOnce(24 * 4, function() camCredits.fade(0xFFFFFFFF, Conductor.instance.beatLengthMs / 250));

	queueFuncOnce(28 * 4, function() {
		camCredits.stopFade();
		thx.text = 'THANKS\n \n ';
		portrait.kill();
	});
	queueFuncOnce(29 * 4, function() thx.text = 'THANKS\nFOR\n ');
	queueFuncOnce(30 * 4, function() thx.text = 'THANKS\nFOR\nPLAY');
	queueFuncOnce(31 * 4, function() thx.text = 'THANKS\nFOR\nPLAYING');
	queueFuncOnce(32 * 4, function() {
		portraitBorder.revive();

		FlxTween.tween(thx, {y: -FlxG.height}, Conductor.instance.beatLengthMs / 500, {ease: FlxEase.sineIn});

		manager.set('rollSize', 640);

		centerRoll = false;
		updateRoll();

		portrait.x = title.x;
		portrait.screenCenter(0x10);

		title.y = (portrait.y - title.height - 20);
	});

	queueFuncOnce(34 * 4, function() thx.kill());
	queueFuncOnce(34 * 4, function() {
		// kablammo
		songCreditGroup.alpha = 1;
		songCreditGroup.x = FlxG.width + 40;
		FlxTween.tween(songCreditGroup, {x: FlxG.width - songCreditGroup.width - 15}, Conductor.instance.beatLengthMs / 700, {ease: FlxEase.quadOut});
	});
	queueFuncOnce(46 * 4, function() FlxTween.tween(songCreditGroup, {x: FlxG.width + 50, alpha: 0}, Conductor.instance.beatLengthMs / 700, {ease: FlxEase.quadIn}));
	queueRollImage(34, 'greenA', '"Mira Mania"');
	queueRollImage(48, 'greenB');
	queueRollImage(64, 'greenC');
	queueRollImage(96, 'tomoA', '"Rosy Rival"');
	queueRollImage(128, 'tomoB');
	queueRollImage(160, 'yellowA', '"Airship Atrocities"');

	queueRollImage(192, 'black');
	queueFuncOnce(192 * 4, function() {
		portraitBorder.kill();

		portrait.anim.addByFrameLabel('idle', 'black idle', 24, false);
		portrait.anim.addByFrameLabel('jumpscare', 'black jumpscare', 24, false);
		portrait.animation.play('idle', true);

		manager.set('rollSize', 640 * portrait.frameWidth / 1280);
		portrait.x -= (191 * portrait.frameWidth / 1280) / 2;
		portrait.y -= (80 * portrait.frameWidth / 1280) / 2;
	});
	queueFuncOnce(210 * 4, function() portrait.animation.play('jumpscare', true));
	queueFuncOnce(224 * 4, function() {
		manager.set('rollSize', 640);

		portraitBorder.revive();

		portrait.x += (191 * portrait.frameWidth / 1280) / 2;
		portrait.y += (80 * portrait.frameWidth / 1280) / 2;
	});

	queueRollImage(224, 'yellowB');
	queueRollImage(256);
	queueRollImage(272, 'henryA', '"Battling the Boyfriend"');
	queueRollImage(304, 'henryB');
	queueRollImage(336, 'tittyA', '"Magmatic Monstrosity"');
	queueRollImage(368, 'tittyB', '"Humane Heartbeat"');
	queueRollImage(400, 'tittyC', '"Deadly Delusion"');
	queueRollImage(432, 'jam', '"Jorsawsee\'s Jams"');

	queueRollImage(528, 'outroA');
	queueRollImage(544, 'outroB');
	queueRollImage(560, 'outroC');
	queueRollImage(576, 'outroD');
	queueRollImage(592);

	// the scroller
	queueFuncOnce(464 * 4, function() portraitBorder.kill());

	queueRollImage(464, 'extra', '');

	queueFuncOnce(528 * 4, function() {
		portrait.screenCenter(0x10);
		portrait.clipRect = null;
		portraitBorder.revive();
	});

	queueFuncOnce(592 * 4, function() victory());
	queueFuncOnce(604 * 4, function() camCredits.fade(0xFF000000, Conductor.instance.beatLengthMs / 1000 * 6));

	FunkinSound.playMusic('sussusEndus', {
		overrideExisting: true,
		restartTrack: true,
		loop: false,
		onComplete: musicComplete
	});
}

function victory():Void
{
	title.kill();
	portrait.kill();

	final r:Float = (1280 / 1920 * .9);
	var black:FunkinSprite = new FunkinSprite().loadSparrow('credits/black');

	black.scale.set(r, r);
	black.updateHitbox();

	black.scrollFactor.set();
	black.animation.addByPrefix('anim', 'black', 24, true);
	black.animation.play('anim');
	black.screenCenter();
	black.x += 15;

	var victoryGlow:FlxSprite = new FlxSprite(0, 0, Paths.image('credits/victoryGlow'));

	victoryGlow.scrollFactor.set();
	victoryGlow.setGraphicSize(FlxG.width, 280);
	victoryGlow.updateHitbox();
	victoryGlow.screenCenter();

	var backRow:FlxSprite = new FlxSprite(0, 0, Paths.image('credits/backRow'));

	backRow.scrollFactor.set();
	backRow.scale.set(r, r);
	backRow.updateHitbox();
	backRow.screenCenter();

	var shadow:FlxSprite = new FlxSprite(0, 0, Paths.image('credits/shadow'));

	shadow.scrollFactor.set();
	shadow.setGraphicSize(1, 720);
	shadow.updateHitbox();
	shadow.screenCenter();

	var shadowBlockLeft:FlxSprite = new FlxSprite().makeGraphic(1, 1, 0xFF000000);

	shadowBlockLeft.scrollFactor.set();
	shadowBlockLeft.setGraphicSize(FlxG.width * .5, 720);
	shadowBlockLeft.updateHitbox();

	var shadowBlockRight:FlxSprite = new FlxSprite(FlxG.width * .5).makeGraphic(1, 1, 0xFF000000);

	shadowBlockRight.scrollFactor.set();
	shadowBlockRight.setGraphicSize(FlxG.width * .5, 720);
	shadowBlockRight.updateHitbox();

	add(victoryGlow);
	add(backRow);
	add(shadow);
	add(shadowBlockLeft);
	add(shadowBlockRight);
	add(black);

	var victory:FlxText = new FlxText(0, 40, 600, 'VICTORY');
	victory.setFormat(Paths.font('vcr.ttf'), 112, 0xff80ffff, 'center');
	victory.screenCenter(0x01);
	victory.scrollFactor.set();
	add(victory);

	var thanks:FlxText = new FlxText(0, 600, 900, 'Thank you for playing!');
	thanks.setFormat(Paths.font('vcr.ttf'), 56, 0xff80ffff, 'center');
	thanks.screenCenter(0x01);
	thanks.scrollFactor.set();
	thanks.alpha = 0;
	add(thanks);

	FlxTween.tween(shadow.scale, {x: r}, 3, {ease: FlxEase.quadInOut, startDelay: .5});
	FlxTween.tween(shadowBlockLeft, {x: -640}, 3, {ease: FlxEase.quadInOut, startDelay: .5});
	FlxTween.tween(shadowBlockRight, {x: FlxG.width * .5 + 640}, 3, {ease: FlxEase.quadInOut, startDelay: .5});
	FlxTween.tween(thanks, {y: 560}, 6, {ease: FlxEase.circOut, startDelay: 1});
	FlxTween.tween(thanks, {alpha: .7}, 4, {startDelay: 1});
	FlxTween.tween(victory, {y: 80}, 7, {ease: FlxEase.sineOut});

	camCredits.fade(0xFF000000, 2, true);
}

function loadCredits():Void
{
	for (sprite in creditsGroup)
		sprite.destroy();

	creditsGroup.clear();

	var y:Float = 0;
	for (credit in credits)
	{
		var creditCluster:FlxSpriteGroup = creditsGroup.add(new FlxSpriteGroup(credit.x, y));

		if (credit.image != null)
		{
			var image:FlxSprite = creditCluster.add(new FlxSprite(0, 0, Paths.image(credit.image)));

			image.scale.set(credit.scale ?? 1, credit.scale ?? 1);
			image.updateHitbox();

			y += (image.height + (credit.spacing ?? 0));

			continue;
		}

		final isTitle:Bool = (credit.icon == null);

		if (isTitle && y > 0)
		{
			creditCluster.y += 60;
			y += 60;
		}

		if (credit.name != null)
		{
			var text:FlxText = creditCluster.add(new FlxText(0, 0, 0, credit.name));
			text.setFormat(Paths.font(credit.font ?? 'impact.ttf'), credit.size ?? (isTitle ? 56 : 40), 0xFFFFFFFF);
			text.active = false;
		}

		var hasIcon:Bool = (credit.icon != null && credit.icon.toLowerCase() != 'none');
		if (hasIcon)
		{
			var isFlagIcon:Bool = (credit.icon.indexOf('flags/') == 0);
			var iconPath:String = 'credits/icons/' + credit.icon;
			if (isFlagIcon) iconPath = 'credits/icons/flags/' + credit.icon.substr(6);

			final iconExists:Bool = Assets.exists(Paths.image(iconPath));
			var icon:FlxSprite = new FlxSprite(0, 0, Paths.image(iconExists ? iconPath : 'credits/icons/unknown'));

			icon.visible = iconExists;
			icon.shader = new FlxRuntimeShader(Assets.getText(Paths.frag('outline2')));
			icon.scale.set(isFlagIcon ? .5 : .5, isFlagIcon ? .5 : .5);
			icon.updateHitbox();

			for (member in creditCluster)
				member.x += Math.round(icon.width + 10);
			icon.y = Math.round((creditCluster.height - icon.height) * .5);

			creditCluster.add(icon);
			icon.active = false;
		}

		y += (credit.spacing ?? (isTitle ? 90 : 70));
	}

	creditsHeight = creditsGroup.height;
}

function rollImage(image:String):Null<FlxGraphic>
{
	var rollPath:String = ('credits/roll/' + image);
	var graphic:Null<FlxGraphic> = (Assets.exists(Paths.image(rollPath)) ?
		{/*trace('load roll image ' + image);*/ Paths.image(rollPath);} : null);

	return graphic;
}

function queueRollImage(beat:Float, ?image:String, ?titleName:String):Void
{
	var graphic:Null<FlxGraphic> = (image != null ? rollImage(image) : null);

	final step:Float = (beat * 4);

	queueEase(step - 6, 6, 'rollAlpha', 0);

	if (titleName != null || image == null) queueEase(step - 6, 6, 'titleAlpha', 0);

	if (image != null)
	{
		if (titleName != null)
		{
			queueFuncOnce(step, function() title.text = titleName);

			queueEase(step, 6, 'titleAlpha', 1);
		}

		queueFuncOnce(step, function() {
			if (graphic != null)
			{
				portrait.loadGraphic(graphic);
			}
			else
			{
				portrait.loadTextureAtlas('credits/roll/' + image);
			}

			updateRoll();

			portrait.revive();
		});

		queueEase(step, 6, 'rollAlpha', 1);
	}
}

function update(elapsed):Void
{
	super.update(elapsed);
	Conductor.instance.update();

	updateStepEvents();

	var beat:Float = Conductor.instance.beatLengthMs;

	camCredits.scroll.y = FlxMath.remapToRange(Conductor.instance.songPosition, beat * 30, beat * 592, 0, creditsHeight
		+ camCredits.height);

	if (Conductor.instance.songPosition >= beat * 464 && Conductor.instance.songPosition < beat * 528)
	{
		portrait.y = FlxMath.remapToRange(Math.min(Conductor.instance.songPosition, beat * 524), beat * 464, beat * 524, 56, FlxG.height - portrait.height - 48);
	}

	if (Conductor.instance.songPosition >= beat * 464 && Conductor.instance.songPosition < beat * 528)
	{
		portrait.clipRect ??= new flixel.math.FlxRect();

		var offset:Float = ((48 - portrait.y) / portrait.scale.y);
		portrait.clipRect.set(0, offset, portrait.frameWidth, (FlxG.height - 96) / portrait.scale.y);
	}

	updateRoll();

	if (controls.BACK && canSkip)
	{
		if (onSkip != null) onSkip();

		close();
	}
}

function musicComplete()
{
	if (!didHandleMusicEnd)
	{
		didHandleMusicEnd = true;
		if (canSkip)
		{
			if (onFinish != null) onFinish();
			close();
		}
		else
		{
			showDoubleTroubleOverlay();
		}
	}
}

function destroy():Void
{
	super.destroy();

	FlxG.cameras.remove(camCredits);

	if (dtCam != null)
	{
		FlxG.cameras.remove(dtCam, true);
		dtCam = null;
	}
}

function updateRoll():Void
{
	title.alpha = manager.get('titleAlpha');

	portrait.alpha = manager.get('rollAlpha');
	portrait.setGraphicSize(manager.get('rollSize'));
	if (!centerRoll) portrait.updateHitbox();
}

var stepEvents:Array<{step:Int, func:Void->Void}> = [];

function queueFuncOnce(step:Int, func:Void->Void)
{
    stepEvents.push({step: step, func: func});
}

function updateStepEvents()
{
    var currentStep = Conductor.instance.currentStep;

    for (i in 0...stepEvents.length)
    {
        var event = stepEvents[i];
        if(event == null) continue;

        if (currentStep == event.step)
        {
            event.func();
            stepEvents.splice(i, 1);
        }
    }
}

function queueEase(step:Int, endStep:Int, name:String, target:Float)
{
    if (step < 0) return;

    var func = function()
    {
        FlxTween.num(
            manager.get(name),
            target,
            (endStep * Conductor.instance.stepLengthMs) / 1000,
            {ease: FlxEase.linear},
            function(v:Float)
            {
                manager.set(name, v);
            }
        );
    };

    queueFuncOnce(step, func);
}
}