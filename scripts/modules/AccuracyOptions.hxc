import funkin.modding.module.Module;
import Std;
import funkin.ui.options.OptionsState;
import funkin.save.Save;

class AccuracyOptions extends Module
{
    public function new(){
        super("AccuracyOptions");

        if(Save.instance.modOptions["Accuracy Format"] == null)
            Save.instance.modOptions["Accuracy Format"] = 'legacy';
    }


    var inOptions:Bool = false;

    override function onStateChangeEnd(event){
        super.onStateChangeEnd(event);
        if(Std.isOfType(event.targetState, OptionsState))
        {
            var prefs = event.targetState.optionsCodex.pages.get("preferences");

            prefs.createPrefItemEnum("Accuracy Format", "Switch between the Accuracy Formats", 
            [
                "Legacy" => 'legacy',
                "Default" => 'default'
            ], function(key:String, value:String) {
                    Save.instance.modOptions.set("Accuracy Format", value);
                    Save.instance.flush();
                }, switch (Std.string(if (Save.instance.modOptions.exists("Accuracy Format")) Save.instance.modOptions.get("Accuracy Format") else "legacy"))
                {
                    case 'legacy': "Legacy";
                    case 'default': "Default";
                });
        }
    }
}
