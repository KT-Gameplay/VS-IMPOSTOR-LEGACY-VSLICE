import flixel.FlxSprite;
import flixel.FlxG;
import flixel.math.FlxMath;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxColor;
import funkin.Paths;
import funkin.play.stage.Stage;
import funkin.play.PlayState;
import funkin.play.character.BaseCharacter;
import funkin.play.character.BaseCharacter.CharacterType;
import funkin.data.character.CharacterData.CharacterDataParser;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.ScriptEvent.SongEventScriptEvent;
import funkin.modding.events.ScriptEvent.SongTimeScriptEvent;
import funkin.modding.events.ScriptEvent.UpdateScriptEvent;

class ToogusStage extends Stage
{
    public var loBlack:FlxSprite;
    public var bfvent:FlxSprite;
    public var ldSpeaker:FlxSprite;
    public var cyanToogus:FlxSprite;

    public var bg:FlxSprite;
    public var fg:FlxSprite;
    public var tn:FlxSprite;

    var walkers:Dynamic = [];
    var camTween:FlxTween;
    var camFollowTween:FlxTween;
    var cyanTween:FlxTween;
    var cyanStartX:Float = 0;

    var isDark:Bool = false;
    var vignette:Bool = false;
    var originalDadId:String = "";

    var originalHealthBarBGColor:Int = 0xFFFFFFFF;
    var originalHealthBarColor:Int = 0xFFFFFFFF;

    public function new()
    {
        super("toogus");
    }

    function isSussusToogus():Bool
    {
        if (PlayState.instance == null)
            return false;

        return PlayState.instance.currentSong.id.toLowerCase() == "sussus-toogus";
    }

    function refreshZ():Void
    {
        if (bg != null)
            bg.zIndex = 0;

        if (fg != null)
            fg.zIndex = 5;

        if (walkers != null)
        {
            for (i in 0...walkers.length)
            {
                var w = walkers[i];

                if (w != null)
                    w.zIndex = 6 + i;
            }
        }

        if (bfvent != null)
            bfvent.zIndex = 20;

        if (tn != null)
            tn.zIndex = 21;

        if (ldSpeaker != null)
            ldSpeaker.zIndex = 22;

        if (loBlack != null)
            loBlack.zIndex = 23;

        if (cyanToogus != null)
            cyanToogus.zIndex = 600;

        refresh();
    }

    function moveCyanToogus():Void
    {
        if (!isSussusToogus())
            return;

        if (cyanToogus == null)
            return;

        if (cyanTween != null)
        {
            cyanTween.cancel();
            cyanTween = null;
        }

        cyanStartX = cyanToogus.x;

        cyanTween = FlxTween.tween(cyanToogus, {x: cyanStartX + 3100}, 16, {
            ease: FlxEase.linear,
            onComplete: function(twn:FlxTween)
            {
                cyanToogus.x = cyanStartX;
                cyanTween = null;
            }
        });
    }

    function comeIn():Void
    {
        if (!isSussusToogus())
            return;

        for (i in 0...walkers.length)
        {
            var w = walkers[i];

            if (w != null)
                w.prepareComeIn();
        }
    }

    function walkAway():Void
    {
        if (!isSussusToogus())
            return;

        for (i in 0...walkers.length)
        {
            var w = walkers[i];

            if (w != null)
                w.prepareWalkAway();
        }
    }

    function comeBack():Void
    {
        if (!isSussusToogus())
            return;

        for (i in 0...walkers.length)
        {
            var w = walkers[i];

            if (w != null)
            {
                w.reviveWalker();
                w.setNewActionTime();
                w.setIdleFrame();
            }
        }

        refreshZ();
    }

    override function buildStage():Void
    {
        super.buildStage();

        bg = cast getNamedProp("bg");
        fg = cast getNamedProp("fg");
        tn = cast getNamedProp("tn");

        bfvent = new FlxSprite(70, 200);
        bfvent.frames = Paths.getSparrowAtlas("BG/mira-cafe/bf_mira_vent");
        bfvent.animation.addByPrefix("vent", "bf vent", 24, false);
        bfvent.animation.play("vent");
        bfvent.alpha = 0;
        add(bfvent);

        ldSpeaker = new FlxSprite(400, 385);
        ldSpeaker.frames = Paths.getSparrowAtlas("BG/mira-cafe/stereo_taken");
        ldSpeaker.animation.addByPrefix("boom", "stereo boom", 24, false);
        ldSpeaker.alpha = 0;
        add(ldSpeaker);

        cyanToogus = new FlxSprite(-1200, 180);
        cyanToogus.frames = Paths.getSparrowAtlas("BG/mira-cafe/cyan_toogus");
        cyanToogus.animation.addByPrefix("idle", "Cyan Dancy", 24, true);
        cyanToogus.animation.play("idle", true);
        cyanToogus.scrollFactor.set(1, 1);
        cyanToogus.zIndex = 600;
        add(cyanToogus);

        loBlack = new FlxSprite().makeGraphic(4000, 2000, FlxColor.BLACK);
        loBlack.alpha = 0.001;
        loBlack.scrollFactor.set(0, 0);
        loBlack.screenCenter();
        add(loBlack);

        walkers = [];

        if (isSussusToogus())
        {
            var defs:Dynamic = [
                new WalkerDef("BG/mira-cafe/walkers", "blue", 0.7),
                new WalkerDef("BG/mira-cafe/walkers", "brown", 0.72),
                new WalkerDef("BG/mira-cafe/walkers", "lime", 0.74),
                new WalkerDef("BG/mira-cafe/walkers", "tan", 0.76),
                new WalkerDef("BG/mira-cafe/walkers", "white", 0.78),
                new WalkerDef("BG/mira-cafe/walkers", "yellow", 0.8),
                new WalkerDef("BG/mira-cafe/foe", "clowfoe", 0.86)
            ];

            for (i in 0...defs.length)
            {
                var def = defs[i];

                var walker = new ToogusWalker(
                    [-700, 1700],
                    210 + i * -16,
                    def.scale,
                    def.atlas,
                    def.prefix
                );

                var isTrue:Bool = FlxG.random.bool(50);

                walker.x = isTrue
                    ? walker.xRange[0] + 50
                    : walker.xRange[1] - 50;

                walker.zIndex = 6 + i;
                walker.hibernating = false;
                walker.visible = true;
                walker.idle = true;
                walker.leaving = false;
                walker.actionTimer = FlxG.random.float(0.5, 3);
                walker.setIdleFrame();

                walkers.push(walker);
                add(walker);
            }
        }

        var dad = getDad();

        if (dad != null)
            originalDadId = dad.characterId;

        if (PlayState.instance != null)
        {
            if (PlayState.instance.healthBarBG != null)
                originalHealthBarBGColor = PlayState.instance.healthBarBG.color;

            if (PlayState.instance.healthBar != null)
                originalHealthBarColor = PlayState.instance.healthBar.color;
        }

        isDark = false;
        vignette = false;

        refreshZ();
    }

    override function onSongStart(event:ScriptEvent):Void
    {
        super.onSongStart(event);

        if (!isSussusToogus())
            return;

        isDark = false;
        vignette = false;

        if (loBlack != null)
            loBlack.alpha = 0.001;

        var bf = getBoyfriend();
        var gf = getGirlfriend();
        var dad = getDad();

        if (bf != null)
            bf.color = FlxColor.WHITE;

        if (gf != null)
            gf.alpha = 1;

        if (dad != null)
            dad.alpha = 1;

        if (bfvent != null)
            bfvent.alpha = 0;

        if (ldSpeaker != null)
            ldSpeaker.alpha = 0;

        if (PlayState.instance != null)
            PlayState.instance.camGame.alpha = 1;

        restoreHealthBar();

        refreshZ();
    }

    override function onStepHit(event:SongTimeScriptEvent):Void
    {
        super.onStepHit(event);

        if (!isSussusToogus())
            return;

        switch (event.step)
        {
            case 704:
                comeIn();

            case 896:
                moveCyanToogus();

            case 1016:
                comeBack();

            case 1792:
                walkAway();
        }

        refreshZ();
    }

    override function onSongEvent(event:SongEventScriptEvent):Void
    {
        super.onSongEvent(event);

        if (!isSussusToogus())
            return;

        if (event == null || event.eventData == null)
            return;

        var eventKind:String = event.eventData.eventKind;

        if (eventKind == null)
            return;

        var kind:String = eventKind.toLowerCase();

        if (kind == "lights out" || kind == "lightsout")
        {
            lightsOut();
            return;
        }

        if (kind == "lights on" || kind == "lightson")
        {
            lightsOn();
            return;
        }

        if (kind != "legacy")
            return;

        var value1:String = "";
        var value2:String = "";

        var rawValue:Dynamic = event.eventData.value;

        if (rawValue != null && Std.isOfType(rawValue, Array))
        {
            var values:Array<Dynamic> = cast rawValue;

            if (values.length > 0 && values[0] != null)
                value1 = Std.string(values[0]);

            if (values.length > 1 && values[1] != null)
                value2 = Std.string(values[1]);
        }
        else
        {
            var objectValue1:String = event.eventData.getString("value1");
            var objectValue2:String = event.eventData.getString("value2");

            if (objectValue1 != null)
                value1 = objectValue1;
            else if (rawValue != null)
                value1 = Std.string(rawValue);

            if (objectValue2 != null)
                value2 = objectValue2;
        }

        value1 = value1.toLowerCase();
        value2 = value2.toLowerCase();

        switch (value1)
        {
            case "vignette on":
                setVignette(true);

            case "vignette off":
                setVignette(false);

            case "lights out":
                lightsOut();

            case "lights on":
                lightsOn();

            case "ending":
                ending();

            case "bye":
                if (PlayState.instance != null)
                    PlayState.instance.camGame.alpha = 0;
        }
    }

    function setVignette(enabled:Bool):Void
    {
        vignette = enabled;

        if (loBlack == null)
            return;

        var targetAlpha:Float = enabled ? 0.35 : 0.001;

        if (isDark)
            targetAlpha = 1;

        FlxTween.cancelTweensOf(loBlack);

        FlxTween.tween(
            loBlack,
            {alpha: targetAlpha},
            0.5,
            {ease: FlxEase.sineOut}
        );
    }

    function lightsOut():Void
    {
        if (!isSussusToogus())
            return;

        isDark = true;

        var bf = getBoyfriend();
        var gf = getGirlfriend();

        if (PlayState.instance != null)
            PlayState.instance.camGame.flash(FlxColor.WHITE, 0.35);

        if (gf != null)
            gf.alpha = 0;

        if (bf != null)
            bf.color = FlxColor.BLACK;

        if (loBlack != null)
        {
            FlxTween.cancelTweensOf(loBlack);
            loBlack.alpha = 1;
        }

        darkenHealthBar();
        changeDadCharacter("green-dark");

        refreshZ();
    }

    function lightsOn():Void
    {
        if (!isSussusToogus())
            return;

        isDark = false;

        var bf = getBoyfriend();
        var gf = getGirlfriend();

        if (bf != null)
            bf.color = FlxColor.WHITE;

        if (gf != null)
            gf.alpha = 1;

        if (PlayState.instance != null)
            PlayState.instance.camGame.flash(FlxColor.BLACK, 0.35);

        restoreHealthBar();

        restoreDadCharacter();

        if (loBlack != null)
        {
            FlxTween.cancelTweensOf(loBlack);

            if (vignette)
                loBlack.alpha = 0.35;
            else
                loBlack.alpha = 0.001;
        }

        refreshZ();
    }

    function ending():Void
    {
        if (!isSussusToogus())
            return;

        setVignette(false);
        lightsOn();

        var bf = getBoyfriend();
        var gf = getGirlfriend();
        var dad = getDad();

        if (bf != null)
            bf.visible = false;

        if (gf != null)
            gf.visible = false;

        if (dad != null)
        {
            dad.visible = true;
            dad.playAnimation("liveReaction", true);
        }

        if (bfvent != null)
        {
            bfvent.alpha = 1;
            bfvent.animation.play("vent", true);
        }

        if (ldSpeaker != null)
        {
            ldSpeaker.alpha = 1;
            ldSpeaker.animation.play("boom", true);
        }

        if (PlayState.instance != null)
            PlayState.instance.camHUD.alpha = 0;
    }

    function changeDadCharacter(charId:String):Void
    {
        if (charId == null || charId == "")
            return;

        var currentDad:BaseCharacter = getDad();

        if (currentDad == null)
            return;

        if (currentDad.characterId == charId)
            return;

        var newDad:BaseCharacter = CharacterDataParser.fetchCharacter(charId);

        if (newDad == null)
            return;

        remove(currentDad);
        currentDad.destroy();

        addCharacter(newDad, CharacterType.DAD);

        refresh();
    }

    function restoreDadCharacter():Void
    {
        if (originalDadId == null || originalDadId == "")
            return;

        var currentDad:BaseCharacter = getDad();

        if (currentDad == null)
            return;

        if (currentDad.characterId == originalDadId)
            return;

        var originalDad:BaseCharacter = CharacterDataParser.fetchCharacter(originalDadId);

        if (originalDad == null)
            return;

        remove(currentDad);
        currentDad.destroy();

        addCharacter(originalDad, CharacterType.DAD);

        refresh();
    }

    function darkenHealthBar():Void
    {
        if (PlayState.instance == null)
            return;

        if (PlayState.instance.healthBarBG != null)
            PlayState.instance.healthBarBG.color = 0xFFE0E0E0;

        if (PlayState.instance.healthBar != null)
            PlayState.instance.healthBar.color = FlxColor.BLACK;
    }

    function restoreHealthBar():Void
    {
        if (PlayState.instance == null)
            return;

        if (PlayState.instance.healthBarBG != null)
            PlayState.instance.healthBarBG.color = originalHealthBarBGColor;

        if (PlayState.instance.healthBar != null)
            PlayState.instance.healthBar.color = originalHealthBarColor;
    }

    override function onDestroy(event:ScriptEvent):Void
    {
        if (camTween != null)
        {
            camTween.cancel();
            camTween = null;
        }

        if (camFollowTween != null)
        {
            camFollowTween.cancel();
            camFollowTween = null;
        }

        if (cyanTween != null)
        {
            cyanTween.cancel();
            cyanTween = null;
        }

        super.onDestroy(event);
    }
}

class WalkerDef
{
    public var atlas:String;
    public var prefix:String;
    public var scale:Float;

    public function new(atlas:String, prefix:String, scale:Float)
    {
        this.atlas = atlas;
        this.prefix = prefix;
        this.scale = scale;
    }
}

class ToogusWalker extends FlxSprite
{
    public var xRange:Dynamic;
    public var walkSpeed:Float = 24;
    public var actionTimer:Float = 0;
    public var hibernating:Bool = false;
    public var idle:Bool = true;
    public var right:Bool = true;
    public var leaving:Bool = false;

    public var delayState:Int = 0;
    public var delayTimer:Float = 0;

    var currentTargetX:Float = 0;

    public function new(xRange:Dynamic, y:Float, sprScale:Float, atlas:String, prefix:String)
    {
        super(xRange[0], y);

        this.xRange = xRange;
        this.walkSpeed = FlxG.random.float(18, 40);
        this.currentTargetX = xRange[0];

        frames = Paths.getSparrowAtlas(atlas);

        if (animation != null)
        {
            animation.addByPrefix("walk", prefix, 24, true);
            animation.play("walk", true, false, 0);
            animation.pause();
        }

        scale.set(sprScale, sprScale);
        updateHitbox();

        scrollFactor.set(1, 1);
        visible = true;
        alpha = 1;
        flipX = false;
    }

    public function setTargetX(value:Float):Void
    {
        currentTargetX = value;
    }

    public function setIdleFrame():Void
    {
        if (animation == null)
            return;

        animation.play("walk", true, false, 19);
        animation.pause();
        visible = true;
    }

    public function beginWalking():Void
    {
        visible = true;
        leaving = false;

        if (animation != null)
        {
            animation.play("walk", true, false, 0);
            animation.resume();
        }

        flipX = !right;
    }

    public function beginLeaving():Void
    {
        visible = true;
        leaving = true;

        if (animation != null)
        {
            animation.play("walk", true, false, 0);
            animation.resume();
        }

        flipX = !right;
    }

    public function setNewActionTime():Void
    {
        actionTimer = FlxG.random.float(0.5, 1);
    }

    public function reviveWalker():Void
    {
        super.revive();

        visible = true;
        alpha = 1;
        alive = true;
        exists = true;
        hibernating = false;

        setIdleFrame();
    }

    override public function kill():Void
    {
        super.kill();

        visible = false;
        idle = true;
        leaving = false;

        setIdleFrame();
    }

    public function prepareComeIn():Void
    {
        delayTimer = FlxG.random.float(0.5, 2);
        delayState = 1;
    }

    public function doComeInAction():Void
    {
        if (hibernating)
            reviveWalker();

        actionTimer = FlxG.random.float(0.5, 1);

        var randX:Float = FlxMath.remapToRange(
            FlxG.random.float(0.2, 0.8),
            0,
            1,
            -700,
            1700
        );

        idle = false;
        leaving = false;
        walkSpeed = FlxG.random.float(18, 40);

        right = (Math.min(x, randX) == x && x != randX);

        setTargetX(randX);
        beginWalking();

        actionTimer = Math.abs((x - randX) / walkSpeed / 9);
    }

    public function prepareWalkAway():Void
    {
        delayTimer = FlxG.random.float(0.5, 2);
        delayState = 2;
    }

    public function doWalkAwayAction():Void
    {
        actionTimer = 999;

        if (!hibernating)
        {
            idle = false;
            leaving = true;
            walkSpeed = FlxG.random.float(18, 40);

            var remapVal:Float = FlxMath.remapToRange(
                FlxG.random.float(0.4, 0.6),
                0,
                1,
                -700,
                1700
            );

            right = Math.max(x, remapVal) == x;

            beginLeaving();
        }
        else
        {
            kill();
        }
    }

    override public function update(elapsed:Float):Void
    {
        super.update(elapsed);

        if (!exists || !alive)
            return;

        if (delayState != 0)
        {
            delayTimer -= elapsed;

            if (Math.min(delayTimer, 0) == delayTimer)
            {
                var stateCpy:Int = delayState;

                delayState = 0;

                if (stateCpy == 1)
                    doComeInAction();

                if (stateCpy == 2)
                    doWalkAwayAction();
            }

            return;
        }

        if (leaving)
        {
            var leaveDir:Float = right ? 1 : -1;

            flipX = !right;
            x += leaveDir * walkSpeed * elapsed * 9;

            var outLeft:Bool =
                Math.min(x, xRange[0] - 250) == x &&
                x != xRange[0] - 250;

            var outRight:Bool =
                Math.max(x, xRange[1] + 250) == x &&
                x != xRange[1] + 250;

            if (outLeft || outRight)
            {
                leaving = false;
                kill();
            }

            return;
        }

        if (idle)
        {
            actionTimer -= elapsed;

            if (Math.min(actionTimer, 0) == actionTimer)
            {
                var randX:Float = FlxMath.remapToRange(
                    FlxG.random.float(0.2, 0.8),
                    0,
                    1,
                    xRange[0],
                    xRange[1]
                );

                currentTargetX = randX;
                walkSpeed = FlxG.random.float(18, 40);

                right = (Math.min(x, randX) == x && x != randX);
                flipX = !right;
                idle = false;

                if (animation != null)
                {
                    animation.play("walk", true, false, 0);
                    animation.resume();
                }

                actionTimer = Math.abs((x - randX) / walkSpeed / 9);
            }

            return;
        }

        var dir:Float = right ? 1 : -1;

        flipX = !right;
        x += dir * walkSpeed * elapsed * 9;

        var reachRight:Bool =
            right &&
            Math.max(x, currentTargetX) == x;

        var reachLeft:Bool =
            !right &&
            Math.min(x, currentTargetX) == x;

        if (reachRight || reachLeft)
        {
            x = currentTargetX;
            idle = true;
            actionTimer = FlxG.random.float(5, 10);

            setIdleFrame();
        }
    }
}